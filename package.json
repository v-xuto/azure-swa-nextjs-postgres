{
  "name": "azure-swa-nextjs-postgres",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:web && npm run build:api",
    "install:web": "cd src/web && npm install",
    "dev:web": "cd src/web && npm run dev",
    "build:web": "cd src/web && npm run build",
    "install:api": "cd src/api && npm install",
    "dev:api": "cd src/api && npm run start",
    "build:api": "cd src/api && npm run build",
    "db:generate": "prisma generate --schema=db/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=db/schema.prisma",
    "db:seed": "tsx --env-file=.env db/seed.ts",
    "db:seed:azure": "pwsh scripts/seed.ps1",
    "db:seed:azure:posix": "bash scripts/seed.sh",
    "setup": "npm install && docker compose up -d && npm run install:api && npm run install:web && npm run build:api && npm run db:generate && npm run db:migrate && npm run db:seed",
    "dev": "swa start"
  },
  "dependencies": {
    "@prisma/client": "^6.2.0"
  },
  "devDependencies": {
    "@azure/static-web-apps-cli": "^2.0.0",
    "azure-functions-core-tools": "^4.0.0",
    "prisma": "^6.2.0",
    "tsx": "^4.19.0"
  }
}
